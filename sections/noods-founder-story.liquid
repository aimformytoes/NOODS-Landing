<div class="page-content">
  <section class="products__pitch reveal" aria-labelledby="pitch-title">
    <h2 class="products__pitch-lead" id="pitch-title">
      <span class="products__pitch-line">
        <span class="products__pitch-chunk">Traditional instant</span>
        <span class="products__pitch-chunk">ramen tastes great.</span>
      </span>
      <span class="products__pitch-line">The ingredients suck.</span>
    </h2>
    <div class="products__pitch-copy products__pitch-copy--wide">
      <p class="products__pitch-body">
        <span class="products__pitch-phrase">Traditional instant noodles are ultra-processed and</span>
        <span class="products__pitch-phrase">leaves us feeling bloated, uncomfortable, and guilty.</span>
      </p>
      <p class="products__pitch-body">
        <span class="products__pitch-phrase">NOODS reimagines instant ramen with a healthier, gut-friendly</span>
        <span class="products__pitch-phrase">alternative packed with prebiotic fiber, support digestive health,</span>
        <span class="products__pitch-phrase">and nourish the good bacteria in your gut.</span>
      </p>
    </div>
    <div class="products__pitch-copy products__pitch-copy--narrow">
      <p class="products__pitch-body">
        <span class="products__pitch-phrase">Traditional instant noodles are</span>
        <span class="products__pitch-phrase">ultra-processed and leaves us feeling</span>
        <span class="products__pitch-phrase">bloated, uncomfortable, and guilty.</span>
      </p>
      <p class="products__pitch-body">
        <span class="products__pitch-phrase">NOODS reimagines instant ramen with</span>
        <span class="products__pitch-phrase">a healthier, gut-friendly alternative</span>
        <span class="products__pitch-phrase">packed with prebiotic fiber, support</span>
        <span class="products__pitch-phrase">digestive health, and nourish the</span>
        <span class="products__pitch-phrase">good bacteria in your gut.</span>
      </p>
    </div>

    <div class="comfort-clouds">
      <ul class="products__clouds">
        <li class="products__cloud"><span class="products__cloud-text">No weird ingredients.</span></li>
        <li class="products__cloud"><span class="products__cloud-text">Love for your gut.</span></li>
        <li class="products__cloud"><span class="products__cloud-text">Guilt-free comfort.</span></li>
      </ul>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <div class="noodle-loop">
        <div class="noodle-loop__tags">
          <span class="noodle-tag">7g Prebiotic Fiber</span>
          <span class="noodle-tag">Clean Ingredients</span>
          <span class="noodle-tag">Air-Dried Not Deep-Fried</span>
          <span class="noodle-tag">Functional Nutrition</span>
          <span class="noodle-tag">Healthy Gut</span>
        </div>
        <svg class="noodle-loop__strand" viewBox="-20 0 2560 100" preserveAspectRatio="none" overflow="visible" aria-hidden="true">
          <path class="noodle-loop__shadow" d="M0 53 C40 11 80 95 120 53 S200 11 280 53 S360 95 440 53 S520 11 600 53 S680 95 760 53 S840 11 920 53 S1000 95 1080 53 S1160 11 1240 53 S1320 95 1400 53 S1480 11 1560 53 S1640 95 1720 53 S1800 11 1880 53 S1960 95 2040 53 S2120 11 2200 53 S2280 95 2360 53 S2440 11 2520 53" />
          <path class="noodle-loop__body" d="M0 50 C40 8 80 92 120 50 S200 8 280 50 S360 92 440 50 S520 8 600 50 S680 92 760 50 S840 8 920 50 S1000 92 1080 50 S1160 8 1240 50 S1320 92 1400 50 S1480 8 1560 50 S1640 92 1720 50 S1800 8 1880 50 S1960 92 2040 50 S2120 8 2200 50 S2280 92 2360 50 S2440 8 2520 50" />
          <path class="noodle-loop__highlight" d="M0 50 C40 8 80 92 120 50 S200 8 280 50 S360 92 440 50 S520 8 600 50 S680 92 760 50 S840 8 920 50 S1000 92 1080 50 S1160 8 1240 50 S1320 92 1400 50 S1480 8 1560 50 S1640 92 1720 50 S1800 8 1880 50 S1960 92 2040 50 S2120 8 2200 50 S2280 92 2360 50 S2440 8 2520 50" />
        </svg>
      </div>
      <div class="noodle-loop" aria-hidden="true">
        <div class="noodle-loop__tags">
          <span class="noodle-tag">7g Prebiotic Fiber</span>
          <span class="noodle-tag">Clean Ingredients</span>
          <span class="noodle-tag">Air-Dried Not Deep-Fried</span>
          <span class="noodle-tag">Functional Nutrition</span>
          <span class="noodle-tag">Healthy Gut</span>
        </div>
        <svg class="noodle-loop__strand" viewBox="-20 0 2560 100" preserveAspectRatio="none" overflow="visible" aria-hidden="true">
          <path class="noodle-loop__shadow" d="M0 53 C40 11 80 95 120 53 S200 11 280 53 S360 95 440 53 S520 11 600 53 S680 95 760 53 S840 11 920 53 S1000 95 1080 53 S1160 11 1240 53 S1320 95 1400 53 S1480 11 1560 53 S1640 95 1720 53 S1800 11 1880 53 S1960 95 2040 53 S2120 11 2200 53 S2280 95 2360 53 S2440 11 2520 53" />
          <path class="noodle-loop__body" d="M0 50 C40 8 80 92 120 50 S200 8 280 50 S360 92 440 50 S520 8 600 50 S680 92 760 50 S840 8 920 50 S1000 92 1080 50 S1160 8 1240 50 S1320 92 1400 50 S1480 8 1560 50 S1640 92 1720 50 S1800 8 1880 50 S1960 92 2040 50 S2120 8 2200 50 S2280 92 2360 50 S2440 8 2520 50" />
          <path class="noodle-loop__highlight" d="M0 50 C40 8 80 92 120 50 S200 8 280 50 S360 92 440 50 S520 8 600 50 S680 92 760 50 S840 8 920 50 S1000 92 1080 50 S1160 8 1240 50 S1320 92 1400 50 S1480 8 1560 50 S1640 92 1720 50 S1800 8 1880 50 S1960 92 2040 50 S2120 8 2200 50 S2280 92 2360 50 S2440 8 2520 50" />
        </svg>
      </div>
    </div>
  </div>

  <section class="founder-story" id="founder-story" aria-labelledby="founder-story-title">
    <div class="container founder-story__box">
      <header class="section-header founder-story__header reveal">
        <h2 class="founder-story__title" id="founder-story-title">
          <span class="founder-story__title-line">Founded by 2</span>
          <span class="founder-story__title-line">food scientist</span>
          <span class="founder-story__title-line">sisters</span>
        </h2>
        <p class="founder-story__intro">
          <span class="founder-story__intro-line">The noods we want didn&rsquo;t exist,</span>
          <span class="founder-story__intro-line">so we created it</span>
        </p>
      </header>
      <figure class="founder-story__comic float-card reveal">
        <img
          class="founder-story__comic-img"
          src="{{ 'noods-founder-comic.png' | asset_url }}"
          alt="Comic strip: two friends crave instant noodles but hate feeling bloated from ultra-processed ones. Realizing they're food scientists, they decide to make noodles that support your gut. After endless testing, they introduce NOODS — prebiotic instant noodles with clean ingredients, air dried, no oils, less sodium, and amazing taste."
          width="1882"
          height="1124"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="pride" id="pride" aria-labelledby="pride-title">
    <svg class="pride__squiggle pride__squiggle--top" viewBox="0 0 1200 110" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path class="pride__squiggle-fill" d="M0 54 C70 8, 150 10, 250 52 C340 92, 410 102, 520 50 C610 8, 700 6, 800 54 C890 96, 980 104, 1080 48 C1140 16, 1175 18, 1200 54 L1200 110 L0 110 Z" />
      <path class="pride__squiggle-line" d="M0 54 C70 8, 150 10, 250 52 C340 92, 410 102, 520 50 C610 8, 700 6, 800 54 C890 96, 980 104, 1080 48 C1140 16, 1175 18, 1200 54" />
    </svg>
    <div class="container">
      <header class="section-header pride__header reveal">
        <h2 class="pride__title" id="pride-title">We Take Pride in Our Noods</h2>
      </header>
    </div>
    <svg class="pride__squiggle pride__squiggle--bottom" viewBox="0 0 1200 110" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path class="pride__squiggle-fill" d="M0 54 C70 8, 150 10, 250 52 C340 92, 410 102, 520 50 C610 8, 700 6, 800 54 C890 96, 980 104, 1080 48 C1140 16, 1175 18, 1200 54 L1200 110 L0 110 Z" />
      <path class="pride__squiggle-line" d="M0 54 C70 8, 150 10, 250 52 C340 92, 410 102, 520 50 C610 8, 700 6, 800 54 C890 96, 980 104, 1080 48 C1140 16, 1175 18, 1200 54" />
    </svg>
  </section>
</div>


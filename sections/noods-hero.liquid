<section class="hero" id="hero">
  <video
    class="hero__video"
    autoplay
    loop
    muted
    playsinline
    aria-hidden="true"
  >
    <source src="{{ 'noods-hero-video.mp4' | asset_url }}" type="video/mp4" />
  </video>

  <div class="hero__layout">
    <div class="hero__group">
      <div class="hero__stack">
        <img
          class="hero__logo"
          src="{{ 'noods-logo.png' | asset_url }}"
          alt="NOODS"
        />

        <p class="hero__banner">
          <span class="hero__banner-line">Your Gut Deserves</span>
          <span class="hero__banner-line hero__banner-line--sub">Better Noodles</span>
        </p>
      </div>

      <div class="hero__cta">
        <button class="btn btn--hero" id="cta-btn" type="button">
          <span class="btn__shimmer" aria-hidden="true"></span>
          <span class="btn__label">Be the First to Try</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>

  <a href="#products" class="hero__scroll" aria-label="Scroll to learn more">
    <span class="hero__scroll-ring" aria-hidden="true"></span>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <path d="M12 5v14M5 12l7 7 7-7"/>
    </svg>
  </a>
</section>

{% schema %}
{
  "name": "NOODS hero",
  "tag": "div",
  "class": "noods-section",
  "presets": [
    {
      "name": "NOODS hero"
    }
  ],
  "enabled_on": {
    "templates": [
      "index"
    ]
  }
}
{% endschema %}

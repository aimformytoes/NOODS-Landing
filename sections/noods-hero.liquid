<section class="hero" id="hero">
  <div class="hero__media">
    <video
      class="hero__video"
      autoplay
      loop
      muted
      playsinline
      aria-label="NOODS commercial"
    >
      <source src="{{ 'noods-hero-video.mp4' | asset_url }}" type="video/mp4" />
    </video>
  </div>

  <div class="hero__cta">
    <button class="btn btn--hero" id="cta-btn" type="button">
      <span class="btn__shimmer" aria-hidden="true"></span>
      <span class="btn__label">Be the First to Try</span>
      <span class="btn__arrow" aria-hidden="true">→</span>
    </button>
    <a href="#products" class="hero__scroll" aria-label="Scroll to learn more">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <path d="M12 5v14M5 12l7 7 7-7"/>
      </svg>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "NOODS hero",
  "tag": "div",
  "class": "noods-section",
  "presets": [
    {
      "name": "NOODS hero"
    }
  ],
  "enabled_on": {
    "templates": [
      "index"
    ]
  }
}
{% endschema %}

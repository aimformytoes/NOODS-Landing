<div class="page-content">
  <section class="cup-stack" id="cup-stack" aria-label="Stacked NOODS cups">
    <div class="cup-stack__stage">
      <img
        class="cup-stack__layer"
        src="{{ 'noods-stack-1.png' | asset_url }}"
        alt="Three NOODS cups stacked: Hot and Spicy, Savoury Beef, and Chicken Broth"
        width="840"
        height="1734"
        draggable="false"
      />
      <img
        class="cup-stack__layer"
        src="{{ 'noods-stack-2.png' | asset_url }}"
        alt=""
        width="840"
        height="1734"
        draggable="false"
      />
      <img
        class="cup-stack__layer"
        src="{{ 'noods-stack-3.png' | asset_url }}"
        alt=""
        width="840"
        height="1734"
        draggable="false"
      />
    </div>
  </section>
</div>

{% schema %}
{
  "name": "NOODS cup stack",
  "tag": "div",
  "class": "noods-section",
  "presets": [
    {
      "name": "NOODS cup stack"
    }
  ],
  "enabled_on": {
    "templates": [
      "index"
    ]
  }
}
{% endschema %}

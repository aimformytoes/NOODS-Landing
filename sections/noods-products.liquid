<div class="page-content">
  <section class="products" id="products">
    <div class="container">
      <header class="section-header products__header reveal">
        <div class="products__header-stack">
          <div class="products__noodle-box" data-noodle-border>
            <svg class="products__noodle-loop" aria-hidden="true" focusable="false">
              <path class="products__noodle-loop__fill" />
              <path class="products__noodle-loop__shadow" fill="none" />
              <path class="products__noodle-loop__body" fill="none" />
              <path class="products__noodle-loop__highlight" fill="none" />
            </svg>
            <div class="products__noodle-box__panel">
              <h2 class="section-title products__title">
                <span class="products__title-line">Instant Noodles</span>
                <span class="products__title-line">Made Better</span>
                <span class="products__title-line">For Your Gut</span>
              </h2>
            </div>
          </div>
          <ul class="products__clouds">
            <li class="products__cloud"><span class="products__cloud-text">No weird ingredients.</span></li>
            <li class="products__cloud"><span class="products__cloud-text">A little love for your gut.</span></li>
            <li class="products__cloud"><span class="products__cloud-text">A whole lot of guilt&#8209;free comfort.</span></li>
          </ul>
        </div>
      </header>

      <div class="products__grid product-reveal">
        <article class="product-card float-card">
          <div class="product-card__icon" aria-hidden="true">
            <img class="product-card__icon-img" src="{{ 'noods-icon-gut.png' | asset_url }}" alt="" width="72" height="72" decoding="async" />
          </div>
          <h3 class="product-card__title">Gut Friendly</h3>
          <p class="product-card__text">7 grams of prebiotic fiber in every bowl. Chicory root inulin helps nourish beneficial gut bacteria and support overall gut health.</p>
        </article>

        <article class="product-card float-card">
          <div class="product-card__icon" aria-hidden="true">
            <img class="product-card__icon-img" src="{{ 'noods-icon-leaf.png' | asset_url }}" alt="" width="72" height="72" decoding="async" />
          </div>
          <h3 class="product-card__title">Clean Ingredients</h3>
          <p class="product-card__text">Made with clean ingredients with no artificial flavors, preservatives, or additives.</p>
        </article>

        <article class="product-card float-card">
          <div class="product-card__icon" aria-hidden="true">
            <svg viewBox="0 0 72 72" width="72" height="72">
              <path d="M28 20 L44 20 L42 12 L30 12 Z" fill="#D99A55" stroke="#111" stroke-width="2.5" stroke-linejoin="round"/>
              <rect x="26" y="20" width="20" height="38" rx="5" fill="#F8E7C8" stroke="#111" stroke-width="2.5"/>
              <circle cx="32" cy="32" r="2.2" fill="#5A3424"/>
              <circle cx="40" cy="38" r="2" fill="#5A3424"/>
              <circle cx="34" cy="46" r="2.2" fill="#5A3424"/>
              <path d="M50 26 L50 52 M46 48 L50 52 L54 48" fill="none" stroke="#E63220" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="product-card__title">Lower Sodium</h3>
          <p class="product-card__text">Big, satisfying flavor with less sodium than traditional instant noodles, so you don&rsquo;t have to choose between better-for-you and actually delicious.</p>
        </article>

        <article class="product-card float-card">
          <div class="product-card__icon" aria-hidden="true">
            <svg viewBox="0 0 72 72" width="72" height="72" aria-hidden="true">
              <path d="M4 16 Q16 4 28 16 T52 16 T68 16" fill="none" stroke="#4A90D9" stroke-width="3.2" stroke-linecap="round"/>
              <path d="M4 32 Q16 20 28 32 T52 32 T68 32" fill="none" stroke="#4A90D9" stroke-width="3.2" stroke-linecap="round"/>
              <path d="M4 48 Q16 36 28 48 T52 48 T68 48" fill="none" stroke="#4A90D9" stroke-width="3.2" stroke-linecap="round"/>
              <path d="M4 64 Q16 52 28 64 T52 64 T68 64" fill="none" stroke="#4A90D9" stroke-width="3.2" stroke-linecap="round" opacity="0.5"/>
            </svg>
          </div>
          <h3 class="product-card__title">Air-Dried, Not Fried</h3>
          <p class="product-card__text">Steamed and air-dried instead of the traditional deep-fried for a healthier noodle with no processing oils!</p>
        </article>
      </div>

      <div class="section-mascots reveal" aria-hidden="true">
        <img src="{{ 'noods-mascot-girls.png' | asset_url }}" alt="" />
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "NOODS product benefits",
  "tag": "div",
  "class": "noods-section",
  "presets": [
    {
      "name": "NOODS product benefits"
    }
  ],
  "enabled_on": {
    "templates": [
      "index"
    ]
  }
}
{% endschema %}

<div class="page-content">
  <section class="flavors" id="flavors" aria-labelledby="flavors-title">
    <svg class="pride__squiggle pride__squiggle--top" viewBox="0 0 1200 110" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path class="pride__squiggle-fill" d="M0 54 C70 8, 150 10, 250 52 C340 92, 410 102, 520 50 C610 8, 700 6, 800 54 C890 96, 980 104, 1080 48 C1140 16, 1175 18, 1200 54 L1200 110 L0 110 Z" />
      <path class="pride__squiggle-line" d="M0 54 C70 8, 150 10, 250 52 C340 92, 410 102, 520 50 C610 8, 700 6, 800 54 C890 96, 980 104, 1080 48 C1140 16, 1175 18, 1200 54" />
    </svg>
    <div class="container">
      <header class="section-header flavors__header reveal">
        <div class="products__noodle-box" data-noodle-border>
          <svg class="products__noodle-loop" aria-hidden="true" focusable="false">
            <path class="products__noodle-loop__fill" />
            <path class="products__noodle-loop__shadow" fill="none" />
            <path class="products__noodle-loop__body" fill="none" />
            <path class="products__noodle-loop__highlight" fill="none" />
          </svg>
          <div class="products__noodle-box__panel">
            <h2 class="flavors__title" id="flavors-title">Meet the Flavors</h2>
          </div>
        </div>
      </header>

      <div class="flavors__carousel" data-flavor-carousel aria-roledescription="carousel">
        <div class="flavors__stage">
          <button class="flavor-cup" type="button" data-flavor="0" data-name="Hot and Spicy">
            <div class="flavor-cup__pop">
              <img src="{{ 'noods-flavor-hot-and-spicy.png' | asset_url }}" alt="NOODS Hot and Spicy instant noodle cup" width="900" height="599" draggable="false" />
            </div>
          </button>
          <button class="flavor-cup" type="button" data-flavor="1" data-name="Savoury Beef">
            <div class="flavor-cup__pop">
              <img src="{{ 'noods-flavor-savoury-beef.png' | asset_url }}" alt="NOODS Savoury Beef instant noodle cup" width="900" height="622" draggable="false" />
            </div>
          </button>
          <button class="flavor-cup" type="button" data-flavor="2" data-name="Chicken Broth">
            <div class="flavor-cup__pop">
              <img src="{{ 'noods-flavor-chicken-broth.png' | asset_url }}" alt="NOODS Chicken Broth instant noodle cup" width="900" height="611" draggable="false" />
            </div>
          </button>
        </div>

        <div class="flavors__controls">
          <button class="flavors__arrow" type="button" data-flavor-prev aria-label="Previous flavor">&larr;</button>
          <p class="flavors__name" aria-live="polite">Hot and Spicy</p>
          <button class="flavors__arrow" type="button" data-flavor-next aria-label="Next flavor">&rarr;</button>
        </div>
        <div class="flavors__cta-row">
          <button class="btn flavors__cta" id="flavors-cta" type="button">
            Be the First to Try
            <svg class="flavors__cta-finger" viewBox="0 0 60 90" aria-hidden="true" focusable="false">
              <path fill="#F8E7C8" stroke="#5A3424" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round" d="M24 40 L24 70 C24 82 36 82 36 70 L36 40 C40 42 52 36 50 26 C48 16 40 10 30 10 C20 10 12 16 12 26 C10 26 4 30 6 36 C8 42 16 40 20 38 C21 39 24 40 24 40 Z"/>
              <path fill="#fff6ea" stroke="#5A3424" stroke-width="1.6" d="M26.5 66h7c.7 0 1.2.6 1.2 1.3v6.2c0 2.4-2.1 4.2-4.7 4.2s-4.7-1.8-4.7-4.2v-6.2c0-.7.5-1.3 1.2-1.3z"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
    <svg class="pride__squiggle pride__squiggle--bottom" viewBox="0 0 1200 110" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path class="pride__squiggle-fill" d="M0 54 C70 8, 150 10, 250 52 C340 92, 410 102, 520 50 C610 8, 700 6, 800 54 C890 96, 980 104, 1080 48 C1140 16, 1175 18, 1200 54 L1200 110 L0 110 Z" />
      <path class="pride__squiggle-line" d="M0 54 C70 8, 150 10, 250 52 C340 92, 410 102, 520 50 C610 8, 700 6, 800 54 C890 96, 980 104, 1080 48 C1140 16, 1175 18, 1200 54" />
    </svg>
  </section>
</div>

{% schema %}
{
  "name": "NOODS flavors",
  "tag": "div",
  "class": "noods-section",
  "presets": [
    {
      "name": "NOODS flavors"
    }
  ],
  "enabled_on": {
    "templates": [
      "index"
    ]
  }
}
{% endschema %}
